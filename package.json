{
  "name": "convert-multiple-files",
  "version": "1.2.5",
  "description": "Convert files to other types",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "!lib/utils/LibreOfficePortable",
    "!lib/utils/LibreOfficePortable/**",
    "!lib/utils/instdir",
    "!lib/utils/instdir/**",
    "!lib/utils/*.tar.gz"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest --config jestconfig.json",
    "dev": "ts-node-dev --transpile-only --ignore-watch node_modules src/index.ts",
    "build": "tsc",
    "lint": "eslint src",
    "postinstall": "node lib/utils/download-libreoffice.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtToledo/Convert-multiple-files.git"
  },
  "keywords": [
    "convert",
    "excel",
    "word",
    "LibreOffice",
    "pdf",
    "doc",
    "docx"
  ],
  "author": "ArtToledo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ArtToledo/Convert-multiple-files/issues"
  },
  "homepage": "https://github.com/ArtToledo/Convert-multiple-files#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "mammoth": "^1.12.2",
    "tar": "^7.5.22"
  }
}
